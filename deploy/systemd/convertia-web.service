# Convertia: servidor web (Express). Escucha solo en 127.0.0.1; nginx hace de proxy.
[Unit]
Description=Convertia - servidor web
After=network.target
Wants=convertia-worker.service

[Service]
Type=simple
User=convertia
Group=convertia
EnvironmentFile=/etc/convertia.env
WorkingDirectory=/var/conversor/app
ExecStart=/var/conversor/node/bin/node src/server.js
Restart=always
RestartSec=2
UMask=0007
# Aislamiento
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ReadWritePaths=/var/conversor/tmp /var/conversor/db /var/conversor/run
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
LockPersonality=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
MemoryMax=1G

[Install]
WantedBy=multi-user.target
